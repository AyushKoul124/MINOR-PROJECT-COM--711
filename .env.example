# ==============================================================================
# SOCMINT Academic Research Prototype — Environment Configuration
# Reference Hardware: NVIDIA GTX 1650 Ti (4GB VRAM) | 16GB RAM | Offline-First
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=socmint
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/socmint
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/socmint

# --- REDIS & CELERY TASK QUEUE ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- COMPONENT A: TELEGRAM MTPROTO INGESTION (Pyrofork) ---
# Acquire API ID & Hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION_NAME=socmint_session
CHANNELS_CONFIG_PATH=config/channels.yaml

# Staggered 30-Channel Polling Math (1 channel every 30s over 20 mins = 1200s)
# 30 channels * ~33.5s (30s interval + 2-5s jitter) = ~16.8 minutes, leaving a 3.2-minute idle buffer
POLL_SCHEDULE_SECONDS=1200
POLL_INTERVAL_SECONDS=30
POLL_JITTER_MIN_SECONDS=2
POLL_JITTER_MAX_SECONDS=5

# --- ML/NLP HARDWARE & MODEL CONFIGURATION ---
# Target Reference: NVIDIA GTX 1650 Ti (4GB VRAM). Set to 'cpu' on non-GPU machines.
DEVICE=cuda
CUDA_EMPTY_CACHE=true

# Locked Runtime Models (Off-the-shelf pre-trained checkpoints)
STANCE_MODEL=valhalla/distilbart-mnli-12-3
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
EMOTION_MODEL=SamLowe/roberta-base-go_emotions
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- RAG LAYER & LLM ROUTING ---
# Viva Default: 'ollama' (air-gapped local model). Optional cloud: 'groq' or 'openai'.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Cloud Providers (Development depth only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- OPERATIONAL THRESHOLDS & DEMO INVARIANTS ---
# Viva Demo capped batch size (guarantees 15–25s execution on GTX 1650 Ti)
DEMO_B_BATCH_SIZE=50
BERTOPIC_MAX_DOCS=500

# Analytical Thresholds
STANCE_CONFIDENCE_THRESHOLD=0.60
RAG_COSINE_CUTOFF=0.65
CIB_ANOMALY_THRESHOLD=0.70

# k-Anonymity Cluster Guards (DPDP Compliance)
# Report standard k=50; demo seed k can be set to 15 for smaller test subsets
MIN_CLUSTER_SIZE=50
DEMO_MIN_CLUSTER_SIZE=15

# --- FASTAPI & DASHBOARD ACCESS ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASIC_AUTH_USERNAME=analyst
API_BASIC_AUTH_PASSWORD=socmint_analyst_2026
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
