<mxfile host="app.diagrams.net" modified="2026-09-15T00:00:00.000Z" agent="Antigravity" version="21.0.0" type="device"><diagram id="Slide_7_-_RAG_Failure_Points" name="Slide 7 - RAG Failure Points"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" background="#0B0F19" math="0" shadow="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;h2 style='margin:0;color:#38BDF8;'&gt;RAG PIPELINE ARCHITECTURE &amp; FAILURE POINTS&lt;/h2&gt;&lt;div style='color:#94A3B8;font-size:12px;'&gt;End-to-End Information Flow with Error Distribution Across Stages&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="260" y="30" width="520" height="50" as="geometry" /></mxCell><mxCell id="st1" value="&lt;b style='color:#F8FAFC;font-size:13px;'&gt;1. USER QUERY&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#CBD5E1;font-size:11px;'&gt;Natural language prompt&lt;br/&gt;Intent &amp; constraints&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;strokeWidth=2;arcSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="140" width="180" height="70" as="geometry" /></mxCell><mxCell id="st2" value="&lt;b style='color:#F8FAFC;font-size:13px;'&gt;2. RETRIEVER&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#CBD5E1;font-size:11px;'&gt;Dense (DPR/HNSW) +&lt;br/&gt;Sparse (BM25) search&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;strokeWidth=2;arcSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="300" y="140" width="180" height="70" as="geometry" /></mxCell><mxCell id="st3" value="&lt;b style='color:#F8FAFC;font-size:13px;'&gt;3. CONTEXT ASSEMBLY&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#CBD5E1;font-size:11px;'&gt;Reranking, truncation &amp;&lt;br/&gt;prompt template packing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;strokeWidth=2;arcSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="540" y="140" width="180" height="70" as="geometry" /></mxCell><mxCell id="st4" value="&lt;b style='color:#F8FAFC;font-size:13px;'&gt;4. LLM GENERATOR&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#CBD5E1;font-size:11px;'&gt;Autoregressive decoding &amp;&lt;br/&gt;factual synthesis&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1D4ED8;strokeWidth=2;arcSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="780" y="140" width="180" height="70" as="geometry" /></mxCell><mxCell id="st5" value="&lt;b style='color:#F8FAFC;font-size:13px;'&gt;5. GROUNDED OUTPUT&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#CBD5E1;font-size:11px;'&gt;Verified Answer +&lt;br/&gt;Source Attributions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#10B981;strokeWidth=2;arcSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="800" y="480" width="160" height="60" as="geometry" /></mxCell><mxCell id="pipe_edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#60A5FA;strokeWidth=2.5;endArrow=block;endFill=1;" parent="1" source="st1" target="st2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pipe_edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#60A5FA;strokeWidth=2.5;endArrow=block;endFill=1;" parent="1" source="st2" target="st3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pipe_edge_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#60A5FA;strokeWidth=2.5;endArrow=block;endFill=1;" parent="1" source="st3" target="st4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pipe_out" value="&lt;span style='color:#34D399;font-size:11px;'&gt;Grounded Flow&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2.5;endArrow=block;endFill=1;" parent="1" source="st4" target="st5" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fp1" value="&lt;div style='text-align:left;padding:3px;'&gt;&#10;&lt;div style='display:flex;justify-content:space-between;'&gt;&#10;&lt;span style='background:#EF4444;color:#FFF;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:bold;'&gt;⚠️ FAILURE POINT 1&lt;/span&gt;&#10;&lt;span style='color:#FCA5A5;font-weight:bold;font-size:10px;'&gt;~5% of Errors&lt;/span&gt;&#10;&lt;/div&gt;&#10;&lt;div style='color:#F87171;font-weight:bold;font-size:12px;margin-top:6px;'&gt;Ambiguous / Underspecified Query&lt;/div&gt;&#10;&lt;div style='color:#E2E8F0;font-size:11px;margin-top:4px;line-height:1.3;'&gt;• Vague semantic search intent&lt;br/&gt;• Polysemy / Lexical mismatch&lt;br/&gt;• Missing temporal/geographic bounds&lt;/div&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;strokeWidth=2;arcSize=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="270" width="180" height="140" as="geometry" /></mxCell><mxCell id="edge_fp1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#EF4444;strokeWidth=2;endArrow=open;endFill=0;" parent="1" source="st1" target="fp1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fp2" value="&lt;div style='text-align:left;padding:3px;'&gt;&#10;&lt;div style='display:flex;justify-content:space-between;'&gt;&#10;&lt;span style='background:#EF4444;color:#FFF;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:bold;'&gt;⚠️ FAILURE POINT 2&lt;/span&gt;&#10;&lt;span style='color:#FCA5A5;font-weight:bold;font-size:10px;'&gt;~40% of Errors&lt;/span&gt;&#10;&lt;/div&gt;&#10;&lt;div style='color:#F87171;font-weight:bold;font-size:12px;margin-top:6px;'&gt;Retrieval Noise &amp; Semantic Drift&lt;/div&gt;&#10;&lt;div style='color:#E2E8F0;font-size:11px;margin-top:4px;line-height:1.3;'&gt;• Low recall: misses ground truth&lt;br/&gt;• High noise: returns distractor chunks&lt;br/&gt;• Outdated corpus passages&lt;/div&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;strokeWidth=2;arcSize=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="300" y="270" width="180" height="140" as="geometry" /></mxCell><mxCell id="edge_fp2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#EF4444;strokeWidth=2;endArrow=open;endFill=0;" parent="1" source="st2" target="fp2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fp3" value="&lt;div style='text-align:left;padding:3px;'&gt;&#10;&lt;div style='display:flex;justify-content:space-between;'&gt;&#10;&lt;span style='background:#EF4444;color:#FFF;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:bold;'&gt;⚠️ FAILURE POINT 3&lt;/span&gt;&#10;&lt;span style='color:#FCA5A5;font-weight:bold;font-size:10px;'&gt;~20% of Errors&lt;/span&gt;&#10;&lt;/div&gt;&#10;&lt;div style='color:#F87171;font-weight:bold;font-size:12px;margin-top:6px;'&gt;'Lost in the Middle' &amp; Cutoffs&lt;/div&gt;&#10;&lt;div style='color:#E2E8F0;font-size:11px;margin-top:4px;line-height:1.3;'&gt;• Positional bias: mid-context ignored&lt;br/&gt;• Semantic chunk boundary truncation&lt;br/&gt;• Redundant or conflicting passages&lt;/div&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;strokeWidth=2;arcSize=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="540" y="270" width="180" height="140" as="geometry" /></mxCell><mxCell id="edge_fp3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#EF4444;strokeWidth=2;endArrow=open;endFill=0;" parent="1" source="st3" target="fp3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fp4" value="&lt;div style='text-align:left;padding:3px;'&gt;&#10;&lt;div style='display:flex;justify-content:space-between;'&gt;&#10;&lt;span style='background:#EF4444;color:#FFF;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:bold;'&gt;⚠️ FAILURE POINT 4&lt;/span&gt;&#10;&lt;span style='color:#FCA5A5;font-weight:bold;font-size:10px;'&gt;~35% of Errors&lt;/span&gt;&#10;&lt;/div&gt;&#10;&lt;div style='color:#F87171;font-weight:bold;font-size:12px;margin-top:6px;'&gt;Generation Drift &amp; Prior Bias&lt;/div&gt;&#10;&lt;div style='color:#E2E8F0;font-size:11px;margin-top:4px;line-height:1.3;'&gt;• Parametric memory overrides context&lt;br/&gt;• Cross-chunk entity hallucination&lt;br/&gt;• Sycophantic hallucination / extrapolation&lt;/div&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;strokeWidth=2;arcSize=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="780" y="270" width="180" height="140" as="geometry" /></mxCell><mxCell id="edge_fp4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#EF4444;strokeWidth=2;endArrow=open;endFill=0;" parent="1" source="st4" target="fp4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>