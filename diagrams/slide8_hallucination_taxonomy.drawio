<mxfile host="app.diagrams.net" modified="2026-09-15T00:00:00.000Z" agent="Antigravity" version="21.0.0" type="device"><diagram id="Slide_8_-_Hallucination_Taxonomy" name="Slide 8 - Hallucination Taxonomy"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" background="#0B0F19" math="0" shadow="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;h2 style='margin:0;color:#38BDF8;'&gt;RAG HALLUCINATION TAXONOMY &amp; ROOT CAUSES&lt;/h2&gt;&lt;div style='color:#94A3B8;font-size:12px;'&gt;Classification by Factual Grounding &amp; Frequency of Primary Causes&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="260" y="25" width="540" height="50" as="geometry" /></mxCell><mxCell id="root" value="&lt;b style='color:#FFFFFF;font-size:15px;'&gt;HALLUCINATION IN RAG&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#94A3B8;font-size:11px;'&gt;Deviation from retrieved factual evidence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#6366F1;strokeWidth=2.5;arcSize=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="400" y="95" width="260" height="55" as="geometry" /></mxCell><mxCell id="node_int" value="&lt;div style='text-align:left;padding:4px;'&gt;&#10;&lt;b style='color:#FCA5A5;font-size:13px;'&gt;🔴 INTRINSIC HALLUCINATION&lt;/b&gt;&#10;&lt;div style='color:#CBD5E1;font-size:11px;margin-top:4px;'&gt;&lt;b&gt;Definition:&lt;/b&gt; Directly &lt;u&gt;contradicts&lt;/u&gt; or distorts facts present in retrieved passages.&lt;/div&gt;&#10;&lt;div style='color:#E2E8F0;font-size:11px;margin-top:6px;line-height:1.3;'&gt;&#10;• &lt;b&gt;Fact Inversion:&lt;/b&gt; Negating dates, numbers, outcomes&lt;br/&gt;&#10;• &lt;b&gt;Entity Swap:&lt;/b&gt; Attributing Action A to Person B&lt;br/&gt;&#10;• &lt;b&gt;Cross-Chunk Merging:&lt;/b&gt; Blending disparate facts falsely&#10;&lt;/div&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;strokeWidth=2;arcSize=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="100" y="180" width="380" height="120" as="geometry" /></mxCell><mxCell id="node_ext" value="&lt;div style='text-align:left;padding:4px;'&gt;&#10;&lt;b style='color:#FDBA74;font-size:13px;'&gt;🟠 EXTRINSIC HALLUCINATION&lt;/b&gt;&#10;&lt;div style='color:#CBD5E1;font-size:11px;margin-top:4px;'&gt;&lt;b&gt;Definition:&lt;/b&gt; Adds ungrounded info &lt;u&gt;unverifiable&lt;/u&gt; against retrieved context.&lt;/div&gt;&#10;&lt;div style='color:#E2E8F0;font-size:11px;margin-top:6px;line-height:1.3;'&gt;&#10;• &lt;b&gt;Parametric Override:&lt;/b&gt; LLM relies on stale internal memory&lt;br/&gt;&#10;• &lt;b&gt;Fabricated Citations:&lt;/b&gt; Inventing fake authors or sources&lt;br/&gt;&#10;• &lt;b&gt;Sycophancy:&lt;/b&gt; Agreeing with user's incorrect assumptions&#10;&lt;/div&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#431407;strokeColor=#F97316;strokeWidth=2;arcSize=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="580" y="180" width="380" height="120" as="geometry" /></mxCell><mxCell id="e_root_int" value="&lt;span style='color:#EF4444;font-size:10px;background:#0B0F19;padding:1px 3px;'&gt;Contradiction&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="root" target="node_int" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_root_ext" value="&lt;span style='color:#F97316;font-size:10px;background:#0B0F19;padding:1px 3px;'&gt;Ungrounded Addition&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="root" target="node_ext" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rc_box" value="&lt;div style='text-align:left;padding:6px;'&gt;&#10;&lt;b style='color:#38BDF8;font-size:13px;'&gt;📊 EMPIRICAL ROOT CAUSE DISTRIBUTION (FREQUENCY BREAKDOWN)&lt;/b&gt;&#10;&lt;table style='width:100%;color:#E2E8F0;font-size:11px;margin-top:8px;border-collapse:collapse;'&gt;&#10;&lt;tr style='border-bottom:1px solid #334155;'&gt;&lt;td style='padding:4px;'&gt;&lt;b&gt;1. Retrieval Noise &amp; Irrelevance&lt;/b&gt;&lt;/td&gt;&lt;td style='color:#38BDF8;font-weight:bold;text-align:right;'&gt;40%&lt;/td&gt;&lt;td style='width:55%;padding-left:10px;'&gt;&lt;div style='background:#0284C7;height:8px;width:100%;border-radius:4px;'&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr style='border-bottom:1px solid #334155;'&gt;&lt;td style='padding:4px;'&gt;&lt;b&gt;2. Context Skipping (Parametric Bias)&lt;/b&gt;&lt;/td&gt;&lt;td style='color:#38BDF8;font-weight:bold;text-align:right;'&gt;25%&lt;/td&gt;&lt;td style='width:55%;padding-left:10px;'&gt;&lt;div style='background:#0284C7;height:8px;width:62%;border-radius:4px;'&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr style='border-bottom:1px solid #334155;'&gt;&lt;td style='padding:4px;'&gt;&lt;b&gt;3. Cross-Chunk Fact Merging&lt;/b&gt;&lt;/td&gt;&lt;td style='color:#38BDF8;font-weight:bold;text-align:right;'&gt;15%&lt;/td&gt;&lt;td style='width:55%;padding-left:10px;'&gt;&lt;div style='background:#0284C7;height:8px;width:37%;border-radius:4px;'&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr style='border-bottom:1px solid #334155;'&gt;&lt;td style='padding:4px;'&gt;&lt;b&gt;4. Knowledge Conflict (Pretraining vs Doc)&lt;/b&gt;&lt;/td&gt;&lt;td style='color:#38BDF8;font-weight:bold;text-align:right;'&gt;10%&lt;/td&gt;&lt;td style='width:55%;padding-left:10px;'&gt;&lt;div style='background:#0284C7;height:8px;width:25%;border-radius:4px;'&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr style='border-bottom:1px solid #334155;'&gt;&lt;td style='padding:4px;'&gt;&lt;b&gt;5. Document Order / Position Bias&lt;/b&gt;&lt;/td&gt;&lt;td style='color:#38BDF8;font-weight:bold;text-align:right;'&gt;5%&lt;/td&gt;&lt;td style='width:55%;padding-left:10px;'&gt;&lt;div style='background:#0284C7;height:8px;width:12%;border-radius:4px;'&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr style='border-bottom:1px solid #334155;'&gt;&lt;td style='padding:4px;'&gt;&lt;b&gt;6. Sycophancy / Prompt Priming&lt;/b&gt;&lt;/td&gt;&lt;td style='color:#38BDF8;font-weight:bold;text-align:right;'&gt;3%&lt;/td&gt;&lt;td style='width:55%;padding-left:10px;'&gt;&lt;div style='background:#0284C7;height:8px;width:7%;border-radius:4px;'&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td style='padding:4px;'&gt;&lt;b&gt;7. Knowledge Base Poisoning&lt;/b&gt;&lt;/td&gt;&lt;td style='color:#38BDF8;font-weight:bold;text-align:right;'&gt;2%&lt;/td&gt;&lt;td style='width:55%;padding-left:10px;'&gt;&lt;div style='background:#0284C7;height:8px;width:5%;border-radius:4px;'&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=2;arcSize=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="100" y="330" width="860" height="210" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>